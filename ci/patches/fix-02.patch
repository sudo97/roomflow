diff --git a/deploy/observability/prometheus/recording.rules.yml b/deploy/observability/prometheus/recording.rules.yml
index 2ee90a5..06bb176 100644
--- a/deploy/observability/prometheus/recording.rules.yml
+++ b/deploy/observability/prometheus/recording.rules.yml
@@ -8,7 +8,8 @@ groups:
       - record: roomflow:http_requests:rate1m
         expr: sum(rate(roomflow_http_requests_total[1m]))
       - record: roomflow:http_errors:ratio_rate1m
-        expr: sum(rate(roomflow_http_requests_total{code=~"5.."}[1m])) / sum(rate(roomflow_http_requests_total[1m]))
+        # "or vector(0)": без жодної відповіді 5xx чисельник порожній, і без цього правило не мало б значення
+        expr: (sum(rate(roomflow_http_requests_total{code=~"5.."}[1m])) or vector(0)) / sum(rate(roomflow_http_requests_total[1m]))
       - record: roomflow:http_latency_seconds:p95_1m
         expr: histogram_quantile(0.95, sum by (le) (rate(roomflow_http_request_duration_seconds_bucket[1m])))
       - record: route:roomflow_http_latency_seconds:p95_1m
@@ -21,7 +22,7 @@ groups:
     rules:
       # SLO: 99.5% успішних (не 5xx) запитів. Error budget = 0.5%.
       - record: slo:availability:ratio_rate5m
-        expr: 1 - (sum(rate(roomflow_http_requests_total{code=~"5.."}[5m])) / sum(rate(roomflow_http_requests_total[5m])))
+        expr: 1 - ((sum(rate(roomflow_http_requests_total{code=~"5.."}[5m])) or vector(0)) / sum(rate(roomflow_http_requests_total[5m])))
       - record: slo:error_budget_burn_rate:5m
         expr: (1 - slo:availability:ratio_rate5m) / 0.005
       - record: slo:error_budget_burn_rate:1m
