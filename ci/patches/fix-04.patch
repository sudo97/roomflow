diff --git a/ci/lab11/backstage.sh b/ci/lab11/backstage.sh
index f6e3e57..05e187d 100644
--- a/ci/lab11/backstage.sh
+++ b/ci/lab11/backstage.sh
@@ -18,19 +18,23 @@ printf 'roomflow-portal\n' | npx -y @backstage/create-app@latest --path $BS --sk
