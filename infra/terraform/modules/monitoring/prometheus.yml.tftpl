# Згенеровано Terraform (модуль monitoring).
global:
  scrape_interval: 5s
  scrape_timeout: 4s
  evaluation_interval: 5s

rule_files: [/etc/rf/alerts.yml]

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  - job_name: roomflow
    dns_sd_configs:
      - names: ${jsonencode([for c in colors : "app-${c}"])}
        type: A
        port: 8080
        refresh_interval: 5s
    relabel_configs:
      - source_labels: [__meta_dns_name]
        regex: app-(.*)
        target_label: color
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
