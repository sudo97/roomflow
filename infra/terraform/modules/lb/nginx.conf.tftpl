# Згенеровано Terraform (модуль lb). Активне середовище: ${color}
events {}

http {
  # Вбудований DNS Docker: імена контейнерів-реплік розв'язуються під час запиту.
  resolver 127.0.0.11 valid=5s ipv6=off;
  access_log /dev/stdout;

  # Прив'язка орендаря до репліки (tenant affinity): усі запити готелю потрапляють в одну репліку,
  # тому стан орендаря в пам'яті репліки узгоджений. Хеш заголовка X-Tenant-ID (MurmurHash2) стабільний.
  split_clients "$http_x_tenant_id" $replica {
%{ for i in range(replicas - 1) ~}
    ${format("%.2f", 100 / replicas)}% ${i};
%{ endfor ~}
    * ${replicas - 1};
  }

  server {
    listen 80;

    location = /lb/active {
      default_type text/plain;
      return 200 "${color}\n";
    }

    location / {
      set $backend "http://${prefix}-${color}-$replica:8080";
      proxy_pass $backend;
      proxy_set_header Host $host;
      proxy_next_upstream error timeout http_502 http_503;
      proxy_connect_timeout 2s;
    }
  }
}
